
# Interest Calculation

print("===== INTEREST CALCULATION =====")

account_type = input("Enter account type (Savings/Current/Fixed): ")
amount = float(input("Enter account balance: "))

if account_type.lower() == "savings":
    rate = 4
elif account_type.lower() == "current":
    rate = 2
elif account_type.lower() == "fixed":
    rate = 7
else:
    print("Invalid account type")
    rate = 0

if rate > 0:
    interest = (amount * rate) / 100

    print("\nAccount Type:", account_type)
    print("Balance: Rs.", amount)
    print("Interest Rate:", rate, "%")
    print("Interest: Rs.", interest)
