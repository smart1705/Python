class Student:
    def __init__(self, name, roll_no):
        self.name = name
        self.roll_no = roll_no

    def display(self):
        print("Student Name:", self.name)
        print("Roll No:", self.roll_no)


class Faculty:
    def __init__(self, name, subject):
        self.name = name
        self.subject = subject

    def display(self):
        print("Faculty Name:", self.name)
        print("Subject:", self.subject)


class Course:
    def __init__(self, course_name):
        self.course_name = course_name

    def display(self):
        print("Course:", self.course_name)


# Create objects
student = Student("Tanisha", 101)
faculty = Faculty("Rahul", "Python")
course = Course("M.Sc. Computer Applications")


while True:
    print("\n===== COLLEGE MANAGEMENT SYSTEM =====")
    print("1. Student Management")
    print("2. Faculty Management")
    print("3. Course Management")
    print("4. Search")
    print("5. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        print("\n--- Student Management ---")
        student.display()

    elif choice == 2:
        print("\n--- Faculty Management ---")
        faculty.display()

    elif choice == 3:
        print("\n--- Course Management ---")
        course.display()

    elif choice == 4:
        print("\n--- Search ---")
        search = input("Enter student name: ")

        if search.lower() == student.name.lower():
            student.display()
        else:
            print("Student not found.")

    elif choice == 5:
        print("Thank you!")
        break

    else:
        print("Invalid choice.")
